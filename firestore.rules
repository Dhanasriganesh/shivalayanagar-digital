rules_version = '2';

/**
 * Shivalaya Nagar Civic Grievance Portal — Cloud Firestore rules
 *
 * Collection: problems
 * Publish: Firebase Console → Firestore Database → Rules → Publish
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isWholeNumber(value) {
      return (value is int || value is float)
        && value == math.floor(value);
    }

    function isStreetId(value) {
      return isWholeNumber(value)
        && value >= 1
        && value <= 11;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value is string
        && value.size() <= maxLen;
    }

    function isOptionalDescription(value) {
      return value is string
        && value.size() <= 600;
    }

    function isValidStatus(value) {
      return value in [
        'open',
        'submitted',
        'pending',
        'in_progress',
        'completed',
        'closed',
        'resolved'
      ];
    }

    function isValidCategoryPair(cat, sub) {
      return (
          cat == 'Drainage'
          && sub in ['Drainage Leakage', 'Manhole Cover Repair', 'No Manhole Cover']
        )
        || (
          cat == 'Electrical'
          && sub in ['No Street Light', 'Non Glowing of Street Light', 'Current Pole Wire Issue']
        )
        || (
          cat == 'Road'
          && sub in ['Potholes']
        );
    }

    function isValidBase64ImageUrl(value) {
      let parts = value.split(',');
      return value is string
        && value.size() >= 64
        && value.size() <= 900000
        && parts.size() == 2
        && parts[0] in [
          'data:image/jpeg;base64',
          'data:image/jpg;base64',
          'data:image/png;base64',
          'data:image/webp;base64'
        ]
        && parts[1].size() >= 32;
    }

    function hasLegacyCreateKeys() {
      return request.resource.data.keys().hasAll([
          'streetId',
          'streetName',
          'heading',
          'description',
          'imageBase64',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'streetId',
          'streetName',
          'heading',
          'description',
          'imageBase64',
          'status',
          'createdAt'
        ]);
    }

    function isValidLegacyCreate() {
      let d = request.resource.data;
      return hasLegacyCreateKeys()
        && isStreetId(d.streetId)
        && isNonEmptyString(d.streetName, 80)
        && isNonEmptyString(d.heading, 120)
        && isOptionalDescription(d.description)
        && isValidBase64ImageUrl(d.imageBase64)
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    function hasNewCreateKeys() {
      return request.resource.data.keys().hasAll([
          'streetId',
          'streetName',
          'category',
          'subcategory',
          'heading',
          'description',
          'landmark',
          'imageBase64',
          'status',
          'createdAt',
          'grievanceNo',
          'citizenName',
          'citizenPhone',
          'assignedTo',
          'assignedPhone'
        ])
        && request.resource.data.keys().hasOnly([
          'streetId',
          'streetName',
          'category',
          'subcategory',
          'heading',
          'description',
          'landmark',
          'imageBase64',
          'status',
          'createdAt',
          'grievanceNo',
          'citizenName',
          'citizenPhone',
          'assignedTo',
          'assignedPhone'
        ]);
    }

    function isValidNewCreate() {
      let d = request.resource.data;
      return hasNewCreateKeys()
        && isStreetId(d.streetId)
        && isNonEmptyString(d.streetName, 80)
        && isValidCategoryPair(d.category, d.subcategory)
        && isNonEmptyString(d.heading, 120)
        && isOptionalDescription(d.description)
        && isNonEmptyString(d.landmark, 40)
        && isValidBase64ImageUrl(d.imageBase64)
        && d.status == 'submitted'
        && d.createdAt == request.time
        && isNonEmptyString(d.grievanceNo, 20)
        && isOptionalString(d.citizenName, 80)
        && isOptionalString(d.citizenPhone, 15)
        && isNonEmptyString(d.assignedTo, 80)
        && isNonEmptyString(d.assignedPhone, 15);
    }

    function isValidStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && isValidStatus(request.resource.data.status);
    }

    function isValidAdminUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['status', 'assignedTo', 'assignedPhone', 'officerRemarks', 'updatedAt'])
        && isValidStatus(request.resource.data.status)
        && (!affected.hasAny(['assignedTo']) || isOptionalString(request.resource.data.assignedTo, 80))
        && (!affected.hasAny(['assignedPhone']) || isOptionalString(request.resource.data.assignedPhone, 15))
        && (!affected.hasAny(['officerRemarks']) || isOptionalString(request.resource.data.officerRemarks, 500))
        && (
          !affected.hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time
        );
    }

    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if isValidLegacyCreate() || isValidNewCreate();
      allow update: if isValidStatusUpdate() || isValidAdminUpdate();
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
